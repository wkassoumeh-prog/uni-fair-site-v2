{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/cms",
      "regex": "^/admin/cms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/cms(?:/)?$"
    },
    {
      "page": "/admin/cms/about",
      "regex": "^/admin/cms/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/cms/about(?:/)?$"
    },
    {
      "page": "/admin/cms/faq",
      "regex": "^/admin/cms/faq(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/cms/faq(?:/)?$"
    },
    {
      "page": "/admin/cms/sponsors",
      "regex": "^/admin/cms/sponsors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/cms/sponsors(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/admin/messages",
      "regex": "^/admin/messages(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/messages(?:/)?$"
    },
    {
      "page": "/admin/registrations",
      "regex": "^/admin/registrations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/registrations(?:/)?$"
    },
    {
      "page": "/ar",
      "regex": "^/ar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ar(?:/)?$"
    },
    {
      "page": "/en",
      "regex": "^/en(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/en(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}